# Copy to meristats.toml and edit. meristats.toml holds machine paths and is not committed.

engine_repo = "/path/to/meridian"
data_dir = "/path/to/data/meristats"
cache_dir = "/path/to/cache/meristats"
fastchess = "/path/to/fastchess"
stockfish = "/path/to/stockfish"

# Number of worker processes. There is no default.
workers = 1

# The Python that has PyTorch, when it is not the Python of meristats. Optional.
trainer_python = "/path/to/trainer/bin/python"

# The nightly cycle. Optional.
lichess_user = "ce_meridian"
networks_branch = "nightly-networks"
anchor_positions = "/path/to/anchor-positions.txt"
